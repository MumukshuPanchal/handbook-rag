# Copy this file to .env and change what you need. The .env file is ignored by git.
# Every variable is optional. The values shown are the defaults.

# Directory for the handbook snapshot and other local data.
HANDBOOK_RAG_DATA_DIR=data

# Minimum severity of log messages: DEBUG, INFO, WARNING or ERROR.
HANDBOOK_RAG_LOG_LEVEL=INFO

# The handbook snapshot to index: repository, exact commit, the directory that holds
# the pages, and the licence the text is published under (SPDX identifier).
# Changing the commit changes the corpus, so results are only comparable for one commit.
HANDBOOK_RAG_HANDBOOK_REPO_URL=https://gitlab.com/gitlab-com/content-sites/handbook.git
HANDBOOK_RAG_HANDBOOK_COMMIT=e645aac6dc6fbb0b759b92ed32f016aaed5ef4b8
HANDBOOK_RAG_HANDBOOK_CONTENT_PATH=content/handbook
HANDBOOK_RAG_HANDBOOK_LICENCE=CC-BY-SA-4.0

# Public address of the handbook, used to build a link to each page.
HANDBOOK_RAG_HANDBOOK_BASE_URL=https://handbook.gitlab.com/handbook/

# Pages with less cleaned text than this many characters are skipped as stubs.
HANDBOOK_RAG_MIN_PAGE_CHARS=200

# Embedding model, and the longest input it reads. Its tokenizer also measures chunk sizes.
HANDBOOK_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HANDBOOK_RAG_EMBEDDING_MAX_TOKENS=512

# Chunking, measured in the embedding model's tokens: the budget for one chunk, the size
# below which a piece is merged into a neighbour, and how much one piece may repeat of
# the piece before it. Changing any of these changes every chunk identifier.
HANDBOOK_RAG_CHUNK_MAX_TOKENS=320
HANDBOOK_RAG_CHUNK_MIN_TOKENS=60
HANDBOOK_RAG_CHUNK_OVERLAP_TOKENS=40

# Instruction placed before a question when it is embedded. This is the one the BGE
# models were trained with. Chunks are embedded without it.
HANDBOOK_RAG_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "

# How many texts the embedding model processes at once. Larger is not always faster:
# memory use grows with batch size and text length.
HANDBOOK_RAG_EMBEDDING_BATCH_SIZE=16

# Address of the Qdrant vector store. `make qdrant` starts one locally.
HANDBOOK_RAG_QDRANT_URL=http://localhost:6333

# How many chunks a search returns.
HANDBOOK_RAG_SEARCH_LIMIT=5

# How chunks are retrieved: dense (by meaning), sparse (by keyword) or hybrid (both merged).
# Hybrid is the default; docs/adr/0011 gives the measurements and the reasoning.
# In hybrid mode each search contributes this many candidates, merged with reciprocal
# rank fusion using the constant below.
HANDBOOK_RAG_RETRIEVAL_MODE=hybrid
HANDBOOK_RAG_FUSION_CANDIDATES=30
HANDBOOK_RAG_RRF_K=60

# Model that builds the sparse keyword vectors.
HANDBOOK_RAG_SPARSE_MODEL=Qdrant/bm25

# Reranking: whether the first search's candidates are re-scored by a cross-encoder,
# which model does it, and how many candidates it is given. More accurate, but slower.
HANDBOOK_RAG_RERANK=false
HANDBOOK_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HANDBOOK_RAG_RERANK_CANDIDATES=30

# The answer cache: whether an answer stored earlier is served again without a request to
# the answer model (docs/adr/0020).
#   off       never.
#   exact     to the same question. Case, spacing, and the question marks, exclamation
#             marks and full stops at its end do not count.
#   semantic  also to a question that a second model, the verifier below, judges to mean
#             the same. This serves more, and it is the risky tier: a question that only
#             looks the same will sometimes get another question's answer. A cached
#             answer names the question it was written for, so compare. It also loads a
#             third model, 552 MiB, which is downloaded the first time it is needed:
#             by the service when it starts, and by `handbook-rag ask` at the first
#             question that has a stored one near it. If it cannot be loaded, the
#             service does not start, and says so: `exact` and `off` need no third model.
# `handbook-rag cache-status` says how many answers are held, and `handbook-rag
# cache-clear` empties it.
HANDBOOK_RAG_CACHE_MODE=semantic

# How sure the verifier must be, in its weaker direction, before a stored answer is
# served to a question worded differently. Higher is stricter. The default is fitted on
# labelled pairs of questions: in the saved run evals/runs/cache/as-built the rule gave
# 0.8669, every threshold from there to 0.9131 serves that run the same, and the default
# is the top of that range to two places. Nothing is known about how it behaves on real
# questions.
HANDBOOK_RAG_CACHE_THRESHOLD=0.91

# How many of the nearest stored questions the verifier is asked about, and the cosine
# below which a stored question is not asked about at all. The number is the
# measurement's own. The floor was read from the same labelled pairs: it saves the
# verifier work and does nothing for correctness.
HANDBOOK_RAG_CACHE_CANDIDATES=3
HANDBOOK_RAG_CACHE_FLOOR=0.7

# The verifier: a cross-encoder that says whether a stored question and a new one imply
# each other. It must be trained for natural language inference and name one output
# "entailment". Loaded when the cache's mode is semantic, and by `handbook-rag
# eval-cache`, which measures the check.
HANDBOOK_RAG_CACHE_VERIFIER_MODEL=cross-encoder/nli-deberta-v3-small

# Tracing: whether each request is recorded as a trace and sent to a trace backend, and
# where. `make traces` starts a local backend with a web page at http://localhost:16686.
HANDBOOK_RAG_TRACING=false
HANDBOOK_RAG_OTLP_ENDPOINT=http://localhost:4318
HANDBOOK_RAG_SERVICE_NAME=handbook-rag

# Whether traces include the text of questions and the full message of errors. Leave
# off outside local debugging: without it a trace holds ids, scores, sizes, timings and
# the names of models and collections, and an error is recorded by its kind only.
HANDBOOK_RAG_TRACE_CONTENT=false

# Device the embedding model runs on: cpu, cuda or mps. Leave unset to use a GPU when
# there is one. The HTTP API and the MCP server use the CPU unless this is set: they embed
# one question at a time, and on an Apple GPU a question after a few idle seconds took about
# 700 ms.
# HANDBOOK_RAG_EMBEDDING_DEVICE=cpu

# The HTTP API (`make serve`). It has no authentication, so by default it accepts
# connections from this machine only.
HANDBOOK_RAG_API_HOST=127.0.0.1
HANDBOOK_RAG_API_PORT=8000

# How many answers the HTTP API writes at once. Each holds a thread while the model
# writes; a question beyond the limit gets 503 with a Retry-After header.
HANDBOOK_RAG_API_MAX_ANSWERS_IN_FLIGHT=4

# The demo page at http://127.0.0.1:8000/, where a question's answer can be watched as
# the model writes it. Like the rest of the API it has no login, and every question asked
# on it spends the answer model's allowance. With false, the page and its two files
# answer 404.
HANDBOOK_RAG_API_DEMO=true

# The model that writes answers. Its name selects the provider: gemini-... is served by
# the Gemini API, claude-... by the Claude API. It must be an exact model name: an alias
# such as gemini-flash-latest is rejected, so that results stay comparable.
HANDBOOK_RAG_ANSWER_MODEL=gemini-3.5-flash-lite

# Credential for the Gemini API. Google AI Studio gives a key free of charge, without
# setting up billing: https://aistudio.google.com/. On the free tier Google may use what
# is sent to improve its products, so send only public text with a free key.
# Put the key only in your .env file. Do not commit it or export it in your shell profile.
GEMINI_API_KEY=

# Credential for the Claude API, needed only when the answer model is a Claude model such
# as claude-haiku-5-5. Create a key at https://platform.claude.com/settings/keys.
ANTHROPIC_API_KEY=

# The most tokens the model may produce for one answer, and how much reasoning a Claude
# model spends: low, medium, high, xhigh or max. A Gemini model uses its own default.
HANDBOOK_RAG_ANSWER_MAX_TOKENS=4000
HANDBOOK_RAG_ANSWER_EFFORT=low

# How many retrieved chunks the model is given to answer from.
HANDBOOK_RAG_ANSWER_CONTEXT_CHUNKS=5

# Time limits for an answer asked for on the command line or over HTTP, in seconds, at
# most 600. The first is how long one request to the model may be silent: to connect,
# and between two pieces of the reply. The Gemini SDK also sends it to the API, and
# whether the API then ends a longer reply was not measured. The second is how long the
# model may be tried again before its first text, counted from its first request, after
# the search: no new attempt starts after it. A request that is already sent runs to its
# own time limit. An evaluation keeps its own limit of 60 seconds and tries a failed
# question again itself. docs/adr/0018 gives the reasoning.
HANDBOOK_RAG_ANSWER_TIMEOUT_SECONDS=20
HANDBOOK_RAG_ANSWER_DEADLINE_SECONDS=30

# A second model, asked once when the answer model has given up: it was overloaded, went
# silent, reached its limit or used up the day's allowance. Not when the answer model is
# wrongly configured, which is for you to fix. It is named like the answer model. Its
# provider's key must be in this file when the service starts: GEMINI_API_KEY for a
# Gemini model, ANTHROPIC_API_KEY for a Claude model. On a free Gemini key, each model
# has an allowance of its own. Empty: no fallback.
HANDBOOK_RAG_ANSWER_FALLBACK_MODEL=
