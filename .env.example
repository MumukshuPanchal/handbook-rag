# Copy this file to .env and change what you need. The .env file is ignored by git.
# Every variable is optional. The values shown are the defaults.

# Directory for the handbook snapshot and other local data.
HANDBOOK_RAG_DATA_DIR=data

# Minimum severity of log messages: DEBUG, INFO, WARNING or ERROR.
HANDBOOK_RAG_LOG_LEVEL=INFO

# The handbook snapshot to index: repository, exact commit, the directory that holds
# the pages, and the licence the text is published under (SPDX identifier).
# Changing the commit changes the corpus, so results are only comparable for one commit.
HANDBOOK_RAG_HANDBOOK_REPO_URL=https://gitlab.com/gitlab-com/content-sites/handbook.git
HANDBOOK_RAG_HANDBOOK_COMMIT=e645aac6dc6fbb0b759b92ed32f016aaed5ef4b8
HANDBOOK_RAG_HANDBOOK_CONTENT_PATH=content/handbook
HANDBOOK_RAG_HANDBOOK_LICENCE=CC-BY-SA-4.0

# Public address of the handbook, used to build a link to each page.
HANDBOOK_RAG_HANDBOOK_BASE_URL=https://handbook.gitlab.com/handbook/

# Pages with less cleaned text than this many characters are skipped as stubs.
HANDBOOK_RAG_MIN_PAGE_CHARS=200

# Embedding model, and the longest input it reads. Its tokenizer also measures chunk sizes.
HANDBOOK_RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HANDBOOK_RAG_EMBEDDING_MAX_TOKENS=512

# Chunking, measured in the embedding model's tokens: the budget for one chunk, the size
# below which a piece is merged into a neighbour, and how much one piece may repeat of
# the piece before it. Changing any of these changes every chunk identifier.
HANDBOOK_RAG_CHUNK_MAX_TOKENS=320
HANDBOOK_RAG_CHUNK_MIN_TOKENS=60
HANDBOOK_RAG_CHUNK_OVERLAP_TOKENS=40
