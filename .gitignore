data/
data-*/

# Evaluation output that is bulky or derived. Scores and summaries are committed.
evals/runs/**/traces/
evals/runs/**/retrieved.jsonl
evals/runs/**/current/
evals/runs/**/report.html
evals/runs/**/state.json
evals/runs/**/trajectory/

# OS and editor files
.DS_Store
.vscode/
.idea/
